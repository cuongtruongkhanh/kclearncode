---
import { SITE } from '../consts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Đường dẫn ảnh dùng cho thẻ Open Graph khi chia sẻ lên Facebook/Twitter. */
  image?: string;
  /** Bài viết dùng og:type="article", trang thường dùng "website". */
  type?: 'website' | 'article';
  publishedTime?: Date;
  /** Trang bài viết dùng khung hẹp cho dễ đọc; danh sách dùng khung rộng hơn. */
  wide?: boolean;
}

const { title, description = SITE.description, image, type = 'website', publishedTime, wide = false } = Astro.props;

const pageTitle = title === SITE.title ? title : `${title} — ${SITE.title}`;
// Chuẩn hoá về dạng CÓ dấu / ở cuối để khớp URL mà Cloudflare Workers thực sự trả về
// (host redirect 307 các URL không có dấu /). Canonical trỏ tới URL bị redirect là sai SEO.
const canonical = new URL(Astro.url.pathname.replace(/\/*$/, '/'), Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="vi_VN" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="alternate" type="application/rss+xml" title={SITE.rssTitle} href={new URL('rss.xml', Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!--
      Gắn data-theme NGAY trong <head>, trước khi trang vẽ, để không bị nháy
      sáng một nhịp khi người đọc đang dùng dark mode. Phải là script đồng bộ.
    -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('kc-theme');
        if (saved === 'dark' || saved === 'light') document.documentElement.dataset.theme = saved;
      } catch {
        /* localStorage bị chặn — dùng prefers-color-scheme làm mặc định */
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Bỏ qua, đọc nội dung</a>
    <Header />
    <main id="main" class="site-main">
      <div class:list={['wrap', { 'wrap--wide': wide }]}>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
