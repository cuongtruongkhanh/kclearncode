---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, POSTS_PER_PAGE } from '../consts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Trang chủ hiện đúng số bài như trang 1 của /blog/, nên link "cũ hơn" đi thẳng
// sang /blog/2/ là liền mạch, không bị nhảy hay lặp bài.
const recent = posts.slice(0, POSTS_PER_PAGE);
const hasOlder = posts.length > POSTS_PER_PAGE;
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <div class="page-intro">
    <h1>{SITE.description}</h1>
    <p>
      Nơi mình gom lại mấy thứ học được từ việc đi tìm lỗi của người khác — và vài chuyện đời chẳng
      liên quan gì đến code
    </p>
  </div>

  <ul class="post-list">
    {
      recent.map((post) => (
        <PostCard
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          categories={post.data.categories}
        />
      ))
    }
  </ul>

  {
    hasOlder && (
      <div class="more-link-wrap">
        <a class="more-link" href="/blog/2/" rel="next">
          Bài cũ hơn
          <span aria-hidden="true">→</span>
        </a>
      </div>
    )
  }
</BaseLayout>
